# Switchboard host configuration. deploy.sh copies this to .env on the host and
# fills in the two secrets; .env is never committed.

# Single operator password for the UI and API. deploy.sh generates a random one.
SWITCHBOARD_PASSWORD=
# Fernet key that encrypts cloud credentials at rest (32 random bytes, urlsafe base64). deploy.sh generates it.
SWITCHBOARD_SECRET_KEY=
# Data directory inside the container; backed by the named volume "data".
SWITCHBOARD_DATA=/data
# Zscaler OneAPI client secret, bind-mounted from the host's ~/.zscaler_api_key.
ZSCALER_API_KEY_FILE=/run/secrets/zscaler_api_key
# Timezone for logs and timestamps in the UI.
TZ=Europe/Amsterdam
