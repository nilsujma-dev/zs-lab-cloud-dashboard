# --- Host configuration and secrets ------------------------------------------
# .env is generated on the host by deploy.sh and holds the operator password and
# the Fernet key. It must never be committed. .env.example is the template.
.env
.env.*
!.env.example
*.local.conf
config/local*
credentials*
*_key
*.pem
*.key
secrets/

# --- Runtime data (lives in the Docker volume, never in the repo) ------------
data/
state/
*.log

# --- Terraform / OpenTofu (use-case checkouts run inside /data, but just in case)
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
.terraform.lock.hcl
crash.log

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- OS / editor -------------------------------------------------------------
.DS_Store
